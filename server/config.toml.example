# Generated by direct server startup.
# Secret Key：用于HMAC哈希API Key，首次启动时生成，部署后请勿更改
secret_key = "change-me-in-production"

# Admin API key: used for admin APIs and agent-core token generation.
# admin_api_key = "your-secure-admin-key"
log_level = "info"

[server]
# 监听地址
addr = "0.0.0.0:8080"
# 请求超时时间(秒)
timeout_secs = 30
# 最大请求体大小(字节)
max_body_size = 10485760
# 是否信任 X-Forwarded-For 获取来源 IP（默认 false，仅在受信任反向代理后开启）
trust_x_forwarded_for = false

[database]
# 数据库连接URL (SQLite)
url = "sqlite:./data/app.db"

[agent]
# 心跳超时(秒)，用于判断Agent是否离线
heartbeat_timeout_secs = 60

[task]
# 任务结果保留时间(天)
result_retention_days = 7
# 文件存储路径
file_storage_path = "./data/files"
# 最大文件大小限制(MB)
max_file_size_mb = 50

[cas]
# 是否启用 CAS 统一认证（校园网统一身份认证）；false 时注册/登录仅校验用户名（旧行为，便于本地开发）
enabled = false
# CAS 统一认证服务器地址
server_url = "https://sso.buaa.edu.cn"
# 在 CAS 白名单中注册的 service 地址（需向统一认证管理员申请注册，未注册会返回“应用未授权”）
service_url = "http://openaaastest.buaa.edu.cn"
